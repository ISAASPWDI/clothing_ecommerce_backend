generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_user_id_fkey")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_fkey")
  @@map("sessions")
}

model Address {
  id         Int     @id @default(autoincrement()) @map("address_id")
  firstName  String  @map("first_name") @db.VarChar(100)
  lastName   String  @map("last_name") @db.VarChar(100)
  company    String? @db.VarChar(100)
  address    String  @db.Text
  optAddress String? @db.Text
  city       String  @db.VarChar(100)
  country    String  @default("??") @db.VarChar(100)
  zipCode    String  @map("zip_code") @db.VarChar(20)
  phone      String  @db.VarChar(20)
  userId     String
  user       User    @relation(fields: [userId], references: [id])

  @@index([userId], map: "addresses_userId_fkey")
  @@map("addresses")
}

model User {
  id            String               @id @default(cuid()) @map("user_id")
  firstName     String?              @map("first_name") @db.VarChar(100)
  lastName      String?              @map("last_name") @db.VarChar(100)
  password      String?              @db.VarChar(200)
  phone         String?              @db.VarChar(20)
  authType      AuthType             @map("auth_type")
  rol           RolType              @default(USER)
  name          String?
  email         String               @unique
  emailVerified DateTime?            @map("email_verified")
  image         String?
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at")
  accounts      Account[]
  addresses     Address[]
  answers       Answer[]
  cart          Cart?                @relation("UserCart")
  orderStatuses OrderStatusHistory[]
  orders        Order[]
  questions     Question[]
  reviews       Review[]
  sessions      Session[]

  @@index([email])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PaymentMethod {
  id          Int     @id @default(autoincrement()) @map("payment_method_id")
  name        String  @db.VarChar(100)
  description String? @map("descr") @db.Text
  code        String? @db.VarChar(50)
  settings    String? @db.Text
  orders      Order[]

  @@map("payment_methods")
}

model Order {
  id                      Int                  @id @default(autoincrement()) @map("order_id")
  userId                  String               @map("user_id")
  paymentMethodId         Int                  @map("payment_method_id")
  status                  OrderStatus
  total                   Decimal              @db.Decimal(14, 2)
  createdAt               DateTime             @default(now()) @map("created_at")
  

  externalReference       String?              @unique @map("external_reference") @db.VarChar(100)
  mercadoPagoPaymentId    String?              @map("mercadopago_payment_id") @db.VarChar(100)
  mercadoPagoPreferenceId String?              @map("mercadopago_preference_id") @db.VarChar(100)
  paidAt                  DateTime?            @map("paid_at")
  

  customerInfoId          Int?                 @unique @map("customer_info_id")
  customerInfo            CustomerInfo?        @relation(fields: [customerInfoId], references: [id])
  
  orderItems              OrderItem[]
  statusHistory           OrderStatusHistory[]
  paymentMethod           PaymentMethod        @relation(fields: [paymentMethodId], references: [id])
  user                    User                 @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([paymentMethodId])
  @@index([externalReference])
  @@map("orders")
}

model CustomerInfo {
  id        Int      @id @default(autoincrement()) @map("customer_info_id")
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  email     String   @db.VarChar(150)
  phone     String   @db.VarChar(20)
  address   String   @db.Text
  apartment String?  @db.VarChar(50)
  city      String?  @db.VarChar(100)
  province  String?  @db.VarChar(100)
  zipCode   String   @map("zip_code") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  
  order     Order?

  @@map("customer_info")
}

model OrderItem {
  id            Int     @id @default(autoincrement()) @map("order_item_id")
  orderId       Int     @map("order_id")
  productId     Int     @map("product_id")
  name          String  @db.VarChar(120) 
  quantity      Int     @db.UnsignedInt
  price         Decimal @db.Decimal(10, 2)
  selectedColor String? @map("selected_color") @db.VarChar(50) 
  selectedSize  String? @map("selected_size") @db.VarChar(50)  
  order         Order   @relation(fields: [orderId], references: [id])
  product       Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        Int          @id @default(autoincrement()) @map("order_status_history_id")
  orderId   Int          @map("order_id")
  userId    String       @map("user_id")
  oldStatus OrderStatus? @map("old_status")
  newStatus OrderStatus  @map("new_status")
  comment   String?      @db.Text
  createdAt DateTime     @default(now()) @map("created_at")
  order     Order        @relation(fields: [orderId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@map("order_status_history")
}

model Cart {
  id        Int        @id @default(autoincrement()) @map("cart_id")
  userId    String     @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  cartItems CartItem[]
  user      User       @relation("UserCart", fields: [userId], references: [id])

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        Int     @id @default(autoincrement()) @map("cart_item_id")
  cartId    Int     @map("cart_id")
  productId Int     @map("product_id")
  quantity  Int     @default(1) @db.UnsignedInt
  price     Decimal @db.Decimal(10, 2)
  cart      Cart    @relation(fields: [cartId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Product {
  id                Int               @id @default(autoincrement()) @map("product_id")
  name              String            @db.VarChar(120)
  slug              String            @unique @db.VarChar(150)
  price             Decimal           @db.Decimal(12, 2)
  description       String?           @db.Text
  quantity          Int               @default(0) @db.UnsignedInt
  reviewCount       Int               @default(0) @map("review_count") @db.UnsignedInt
  metaTitle         String?           @map("meta_title") @db.VarChar(200)
  metaDescription   String?           @map("meta_description") @db.Text
  metaKeywords      String?           @map("meta_keywords") @db.VarChar(255)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  productAges       ProductAge[]
  productCategories ProductCategory[]
  productColors     ProductColor[]
  productDetails    ProductDetail[]
  productGenres     ProductGenre[]
  productImages     ProductImage[]
  productSizes      ProductSize[]
  questions         Question[]
  reviews           Review[]

  @@index([name])
  @@index([slug])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement()) @map("product_image_id")
  productId Int      @map("product_id")
  imagePath String   @map("image_path") @db.VarChar(255)
  alt       String?  @db.VarChar(150)
  sortOrder Int      @default(0) @map("sort_order") @db.UnsignedInt
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Question {
  id        Int      @id @default(autoincrement()) @map("question_id")
  productId Int      @map("product_id")
  userId    String   @map("user_id")
  question  String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  answers   Answer[]
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@map("questions")
}

model Answer {
  id         Int      @id @default(autoincrement()) @map("answer_id")
  questionId Int      @map("question_id")
  userId     String   @map("user_id")
  answer     String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  question   Question @relation(fields: [questionId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([questionId])
  @@index([userId])
  @@map("answers")
}

model Review {
  id          Int            @id @default(autoincrement()) @map("review_id")
  productId   Int            @map("product_id")
  userId      String         @map("user_id")
  title       String         @db.VarChar(100)
  description String?        @db.Text
  quality     QualityRating?
  recommended Boolean?
  createdAt   DateTime       @default(now()) @map("created_at")
  product     Product        @relation(fields: [productId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
  images      ReviewImage[]

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model ReviewImage {
  id        Int      @id @default(autoincrement()) @map("review_image_id")
  reviewId  Int      @map("review_id")
  imagePath String?  @map("image_path") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  review    Review   @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
  @@map("reviews_images")
}


model ProductDetail {
  id        Int     @id @default(autoincrement()) @map("product_detail_id")
  productId Int     @map("product_id")
  key       String  @db.VarChar(100)
  value     String? @db.Text
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_details")
}

model Category {
  id                Int               @id @default(autoincrement()) @map("category_id")
  name              String            @db.VarChar(100)
  slug              String            @unique @db.VarChar(150)
  metaTitle         String?           @map("meta_title") @db.VarChar(200)
  metaDescription   String?           @map("meta_description") @db.Text
  metaKeywords      String?           @map("meta_keywords") @db.VarChar(255)
  productCategories ProductCategory[]

  @@index([slug])
  @@map("categories")
}

model ProductCategory {
  id         Int      @id @default(autoincrement()) @map("product_category_id")
  categoryId Int      @map("category_id")
  productId  Int      @map("product_id")
  category   Category @relation(fields: [categoryId], references: [id])
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([productId])
  @@map("product_categories")
}

model Age {
  id          Int          @id @default(autoincrement()) @map("age_id")
  range       String       @db.VarChar(50)
  productAges ProductAge[]

  @@map("ages")
}

model ProductAge {
  id        Int     @id @default(autoincrement()) @map("product_age_id")
  ageId     Int     @map("age_id")
  productId Int     @map("product_id")
  age       Age     @relation(fields: [ageId], references: [id])
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([ageId])
  @@index([productId])
  @@map("product_ages")
}

model Genre {
  id            Int            @id @default(autoincrement()) @map("genre_id")
  genre         String         @db.VarChar(50)
  productGenres ProductGenre[]

  @@map("genres")
}

model ProductGenre {
  id        Int     @id @default(autoincrement()) @map("product_genre_id")
  productId Int     @map("product_id")
  genreId   Int     @map("genre_id")
  genre     Genre   @relation(fields: [genreId], references: [id])
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([genreId])
  @@map("product_genres")
}

model Size {
  id           Int           @id @default(autoincrement()) @map("size_id")
  size         String        @db.VarChar(50)
  productSizes ProductSize[]

  @@map("sizes")
}

model ProductSize {
  id        Int     @id @default(autoincrement()) @map("product_size_id")
  productId Int     @map("product_id")
  sizeId    Int     @map("size_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Size    @relation(fields: [sizeId], references: [id])

  @@index([productId])
  @@index([sizeId])
  @@map("product_sizes")
}

model Color {
  id            Int            @id @default(autoincrement()) @map("color_id")
  color         String         @db.VarChar(100)
  productColors ProductColor[]

  @@map("colors")
}

model ProductColor {
  id        Int     @id @default(autoincrement()) @map("product_color_id")
  colorId   Int     @map("color_id")
  productId Int     @map("product_id")
  color     Color   @relation(fields: [colorId], references: [id])
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([colorId])
  @@index([productId])
  @@map("product_colors")
}

enum AuthType {
  MANUAL
  PROVIDER
}

enum RolType {
  ADMIN
  USER
}

enum OrderStatus {
  Procesando
  Enviado
  Entregado
  PENDING 
  PAID      
  REJECTED  
  CANCELLED  
}

enum QualityRating {
  malo
  bueno
  genial
}
